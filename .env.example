# ---------- Telegram bot (needed to run) ----------
# From @BotFather. Add this bot as an ADMIN of your channel (Post Messages).
TG_BOT_TOKEN=
# Your channel: @BrickDealIL  (or the -100... numeric id)
CHANNEL_ID=
# Where approval prompts go: start a DM with your bot and put your user id here,
# or a private group id. Leave blank to auto-queue with no approval step.
STAGING_CHAT_ID=

# ---------- Behaviour ----------
POST_INTERVAL_MINUTES=180   # drip one deal every N minutes
AUTO_APPROVE=false          # true = skip the approve/reject tap

# ---------- Auto-reader (optional — hands-free ingest) ----------
# From https://my.telegram.org . Use a SECONDARY account, not your main.
TG_API_ID=
TG_API_HASH=
TG_SESSION=                 # generate with: npm run login
# Comma-separated source channels you've joined: @chan1,@chan2
SOURCE_CHANNELS=

# ---------- AliExpress (add when your API app is approved) ----------
ALI_APP_KEY=
ALI_APP_SECRET=
ALI_TRACKING_ID=
ALI_APP_SIGNATURE=
BRAND_NAME=
DISCLOSURE=קישור שותפים
