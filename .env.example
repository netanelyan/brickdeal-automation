# ---------- Telegram bot (needed to run) -----------
# From @BotFather. Add this bot as an ADMIN of your channel (Post Messages).
TG_BOT_TOKEN=
# Your channel: @BrickDealIL  (or the -100... numeric id)
CHANNEL_ID=
# Where approval prompts go: start a DM with your bot and put your user id here,
# or a private group id. Leave blank to auto-queue with no approval step.
STAGING_CHAT_ID=
# Your Telegram user id (message @userinfobot to get it). Required — the bot
# refuses to start without it, and ignores everyone whose id doesn't match.
OWNER_ID=

# ---------- Behaviour ----------
POST_INTERVAL_MINUTES=180   # drip one deal every N minutes
AUTO_APPROVE=false          # true = skip the approve/reject tap
SEEN_TTL_DAYS=10            # a posted product can be posted again after N days

# ---------- Monitoring (status DMs to STAGING_CHAT_ID, in Hebrew) ----------
HEARTBEAT_HOURS=6           # health-summary DM every N hours (only while the reader is up)
SKIP_DIGEST_HOURS=3         # how often to batch-send quality-skipped deals
QUALITY_SKIP_NOTIFY=digest  # off | each | digest — visibility into the quality filter
QUIET_ALERT_HOURS=3         # alert once if the reader goes this long without a new deal
DEBUG=false                 # true = trace the first 10 ingested links on boot (also: /debug [n] anytime)

# ---------- Auto-reader (optional — hands-free ingest) ----------
# From https://my.telegram.org . Use a SECONDARY account, not your main.
TG_API_ID=
TG_API_HASH=
TG_SESSION=                 # generate with: npm run login
# Comma-separated source channels you've joined: @chan1,@chan2
SOURCE_CHANNELS=
# On startup, ingest each source channel's last N messages (0 = off)
BACKFILL_COUNT=30
# TEMPORARY diagnostic logging (per-source entity resolution, every raw
# update received, a 5-min liveness heartbeat) — set to false once the "live
# reader receives nothing" investigation is resolved.
READER_VERBOSE=true
# Live push doesn't reliably reach this account for broadcast channels (only
# for groups it's active in) — the reader polls each source channel's latest
# messages this often as the actual delivery guarantee, independent of push.
CHANNEL_POLL_MINUTES=3

# ---------- AliExpress (add when your API app is approved) ----------
ALI_APP_KEY=
ALI_APP_SECRET=
ALI_TRACKING_ID=
ALI_APP_SIGNATURE=
BRAND_NAME=
DISCLOSURE=קישור שותפים

# --- website feed (deals.json) -------------------------------------------
# Where src/deals.js writes the feed when a deal is posted to the channel.
# The site is served by Caddy straight from the web root on the same VPS, so
# this points there rather than at data/. Defaults to data/deals.json if unset,
# which would leave the website silently empty — the bot writes a perfectly good
# feed somewhere nothing serves it from.
DEALS_PATH=/var/www/brickdeal/deals.json

# scripts/rebuild-deals.js — one-off archive rebuild from the channel history.
#
# SITE_TRACKING_ID separates website clicks from channel clicks in AliExpress
# reporting. It MUST already exist as a Tracking ID in your Portals account:
# link.generate does not error on an unknown id, it just returns links that
# never attribute. The script preflights one link and aborts if it comes back
# empty. Leave blank to fall back to ALI_TRACKING_ID.
SITE_TRACKING_ID=

# The reader's TG_SESSION belongs to the worker account, which watches the
# SOURCE channels and is not necessarily a member of your own channel. Set this
# to a session for the account that owns the channel (npm run login) to run the
# archive rebuild without disturbing the running reader.
BACKFILL_TG_SESSION=

# --- nightly price refresh (scripts/refresh-deals.js) ---------------------
# Re-checks the oldest-checked deals in the feed and marks vanished listings
# dead. Installed as the brickdeal-refresh systemd timer (nightly 03:17).
REFRESH_BATCH=200
REFRESH_THROTTLE_MS=1200
REFRESH_DEAD_STRIKES=2
