# ---------- Telegram bot (needed to run) ----------
TG_BOT_TOKEN=
CHANNEL_ID=
STAGING_CHAT_ID=
OWNER_ID=

# ---------- Behaviour ----------
POST_INTERVAL_MINUTES=180
AUTO_APPROVE=false
SEEN_TTL_DAYS=10

# ---------- Monitoring ----------
HEARTBEAT_HOURS=6
SKIP_DIGEST_HOURS=3
QUALITY_SKIP_NOTIFY=digest
QUIET_ALERT_HOURS=3
DEBUG=false

# ---------- Localisation ----------
TARGET_CURRENCY=ILS
TARGET_LANGUAGE=he
TARGET_COUNTRY=IL

# ---------- AI-polished Hebrew names (optional) ----------
# Get a key at https://console.anthropic.com . Without it, titles are used as-is.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---------- Auto-reader (optional) ----------
TG_API_ID=
TG_API_HASH=
TG_SESSION=
SOURCE_CHANNELS=
BACKFILL_COUNT=30
READER_VERBOSE=true
CHANNEL_POLL_MINUTES=3

# ---------- AliExpress ----------
ALI_APP_KEY=
ALI_APP_SECRET=
ALI_TRACKING_ID=
ALI_APP_SIGNATURE=
BRAND_NAME=
DISCLOSURE=קישור שותפים
